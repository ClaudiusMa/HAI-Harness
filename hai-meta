#!/usr/bin/env bash
# Use the ordinary local-source installer for this repository's own install.
# The harness lives in .hai/ like any project's; the repository note in the root
# AGENTS.md is maintained in Git, and only the HAI-Harness block there is managed.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
CLI="$ROOT/bin/hai-harness.mjs"

usage() {
  cat <<'USAGE'
Usage: ./hai-meta <bootstrap|sync|doctor|help>

  bootstrap  Install missing generic harness files into .hai/ (ordinary init).
  sync       Refresh core methods, shipped skills and the root AGENTS.md block (ordinary update).
  doctor     Check the .hai/ installation (ordinary doctor).

Uses this checkout's bin/hai-harness.mjs with --target at the repository root,
so the harness lands in .hai/ exactly as in any other project.
Project records and the root AGENTS.md note are checked-in source, not generated seeds.
Bootstrap cannot reconstruct lost project history; recover that from Git.
No options are accepted, including --force. Use the CLI directly for dry runs.
USAGE
}

if [ "$#" -gt 1 ]; then
  echo "hai-meta: options are not supported (including --force)" >&2
  exit 1
fi
case "${1:-help}" in
  bootstrap) command=init ;;
  sync) command=update ;;
  doctor) command=doctor ;;
  help|-h|--help) usage; exit 0 ;;
  *) echo "hai-meta: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac

[ -f "$CLI" ] || { echo "hai-meta: cannot find installer at $CLI" >&2; exit 1; }
command -v node >/dev/null 2>&1 || { echo "hai-meta: node is required" >&2; exit 1; }
exec node "$CLI" "$command" --target "$ROOT"
