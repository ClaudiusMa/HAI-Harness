# --- helpers ----------------------------------------------------------------

# Overwrite a .hai file with the meta seed only when it is safe: missing, still
# byte-identical to the product template it was copied from, or --force. Once
# you've edited it, it is preserved.
seed_templated() {
  local hai_rel="$1" tmpl_rel="$2" writer="$3"
  local dest="$HAI/$hai_rel" tmpl="$ROOT/$tmpl_rel"
  mkdir -p "$(dirname "$dest")"
  if [ "$FORCE" = "1" ] || [ ! -f "$dest" ] || { [ -f "$tmpl" ] && cmp -s "$dest" "$tmpl"; }; then
    "$writer" "$dest"
    echo "  seeded:    .hai/$hai_rel"
  else
    echo "  preserved: .hai/$hai_rel (locally edited)"
  fi
}

# Write a file that has no product template counterpart, unless it already
# exists (so we never clobber a customized CLAUDE.md / README).
seed_absent() {
  local dest="$1" writer="$2" label="$3"
  if [ "$FORCE" = "1" ] || [ ! -f "$dest" ]; then
    mkdir -p "$(dirname "$dest")"
    "$writer" "$dest"
    echo "  seeded:    $label"
  else
    echo "  preserved: $label (already present)"
  fi
}

require_cli() {
  [ -f "$CLI" ] || { echo "hai-meta: cannot find installer at $CLI" >&2; exit 1; }
  command -v node >/dev/null 2>&1 || { echo "hai-meta: node is required but not on PATH" >&2; exit 1; }
}

refresh_managed_redirects() {
  write_agents_override "$ROOT/AGENTS.override.md"
  echo "  managed:   AGENTS.override.md"
}

# --- commands ---------------------------------------------------------------

cmd_bootstrap() {
  require_cli
  echo "Bootstrapping the outer (.hai/) harness in $ROOT"
  echo ""
  mkdir -p "$HAI"

  # 1. Lay down the product templates (skips files that already exist).
  node "$CLI" init --target "$HAI"
  echo ""

  # 2. Replace the generic templates with meta-specific seeds where untouched.
  echo "Applying meta-harness seeds:"
  seed_templated "Agents/project_context.md" "Agents/project_context.md" write_project_context
  seed_templated "Agents/planning.md"        "Agents/planning.md"        write_planning
  seed_templated "Human/brief.md"            "Human/brief.md"            write_brief
  seed_absent    "$HAI/README.md"            write_hai_readme            ".hai/README.md"

  # 3. Refresh managed redirects at the repo root.
  refresh_managed_redirects
  seed_absent    "$ROOT/CLAUDE.md"           write_claude_md             "CLAUDE.md"
  echo ""
  echo "Done. The outer harness is ready in .hai/"
  echo "Start a session and read .hai/AGENTS.md (root redirects point there)."
}

cmd_sync() {
  require_cli
  [ -d "$HAI" ] || { echo "hai-meta: .hai/ not found — run './hai-meta bootstrap' first" >&2; exit 1; }
  echo "Syncing the outer (.hai/) harness from the product source"
  echo ""

  # 1. Official scaffold refresh: AGENTS.md, onboarding, role docs. This never
  #    touches project-specific files (planning, tasks, handoffs, lessons, brief).
  node "$CLI" update --target "$HAI"
  echo ""

  # 2. Mirror the parts of the scaffold `update` doesn't cover but the dogfood
  #    instance should track: the skills the harness ships.
  if [ -d "$ROOT/Agents/skills" ]; then
    mkdir -p "$HAI/Agents/skills"
    cp -R "$ROOT/Agents/skills/." "$HAI/Agents/skills/"
    echo "Mirrored: Agents/skills/ -> .hai/Agents/skills/"
  fi
  refresh_managed_redirects
  echo ""
  echo "Done. The outer harness now reflects the current product scaffold."
  echo "Your working files (planning.md, tasks/, handoffs/, lessons/, brief.md) were left untouched."
}

cmd_doctor() {
  require_cli
  node "$CLI" doctor --target "$HAI"
  [ -f "$ROOT/AGENTS.override.md" ] || {
    echo "hai-meta: missing managed root AGENTS.override.md; run './hai-meta sync'" >&2
    exit 1
  }
  grep -Fq '.hai/AGENTS.md' "$ROOT/AGENTS.override.md" || {
    echo "hai-meta: AGENTS.override.md does not route to .hai/AGENTS.md" >&2
    exit 1
  }
  if git -C "$ROOT" check-ignore -q AGENTS.override.md; then
    echo "hai-meta: AGENTS.override.md must be eligible for version control" >&2
    exit 1
  fi
  echo "Managed Codex redirect exists, routes to .hai/, and is eligible for version control."
}

usage() {
  cat <<'USAGE'
hai-meta — the harness on top of the harness (version-controlled development context)

Usage:
  ./hai-meta bootstrap [--force]   Create or repair .hai/ and managed root redirects.
  ./hai-meta sync      [--force]   Pull the latest product scaffold into .hai/ (self-update).
  ./hai-meta doctor                Check that .hai/ has the expected harness files.
  ./hai-meta help

The .hai/ instance, AGENTS.override.md, CLAUDE.md, and this script are
version-controlled. Machine-local settings and receipts stay ignored; the
installable package excludes this development context.
USAGE
}

# --- entrypoint -------------------------------------------------------------

main() {
  local command="${1:-help}"
  shift || true
  for arg in "$@"; do
    case "$arg" in
      --force) FORCE=1 ;;
      *) echo "hai-meta: unknown option '$arg'" >&2; exit 1 ;;
    esac
  done

  case "$command" in
    bootstrap) cmd_bootstrap ;;
    sync)      cmd_sync ;;
    doctor)    cmd_doctor ;;
    help|-h|--help) usage ;;
    *) echo "hai-meta: unknown command '$command'" >&2; echo ""; usage; exit 1 ;;
  esac
}

main "$@"
